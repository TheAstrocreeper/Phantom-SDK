{
  "manifest_version": 3,
  "name": "Phantom Native Transport (Prototype)",
  "version": "0.0.1",
  "description": "Connect Phantom Share to its installed native bulk-transport helper.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://phantomshare.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
